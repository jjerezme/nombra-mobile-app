{
  "name": "nombra",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check:styles": "node scripts/check-styles.mjs",
    "apk": "build-apk",
    "apk:preview": "build-apk --preview",
    "apk:production": "build-apk --production",
    "aab": "build-apk --aab --no-serve --upload"
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/crashlytics": "^26.4.0",
    "@react-native-firebase/firestore": "^26.4.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-localization": "~58.0.5",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "i18next": "^26.4.2",
    "react": "19.2.3",
    "react-i18next": "^17.0.15",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/android/",
      "/dist/",
      "/builds/"
    ]
  },
  "optionalDependencies": {
    "@jujeme/mobile-tools": "git+https://github.com/jjerezme/mobile-tools.git#v0.1.0"
  }
}
