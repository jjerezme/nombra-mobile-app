rules_version = '2';

// Each person can read, write and delete only their own backup document, `users/{uid}`, and only with the fields the
// app writes. Everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['rulesJson', 'writer', 'schema', 'updatedAt'])
        && request.resource.data.rulesJson is string
        && request.resource.data.rulesJson.size() < 500000
        && request.resource.data.writer is string
        && request.resource.data.writer.size() < 100
        && request.resource.data.schema == 1
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
